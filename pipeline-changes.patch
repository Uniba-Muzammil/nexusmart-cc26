+def _dsn():
+    """libpq key=value string for tools/load_postgres.py (values quoted, so any password works). Never logged."""
+    def q(v):
+        return "'" + str(v).replace("\\", "\\\\").replace("'", "\\'") + "'"
+    return " ".join(f"{k}={q(v)}" for k, v in _wh_params().items())
+
+
+def _connect():
+    import psycopg2
+    conn = psycopg2.connect(**_wh_params())
+    conn.autocommit = True          # the SQL files manage their own BEGIN/COMMIT
+    return conn
 
