# Is file ko copy karke .env banao aur apni value likho. .env git mein NAHI jaata.
# Copy this file to .env and fill in your own values. .env is never committed.
AIRFLOW_UID=50000
WH_PW=change_me_locally

# Airflow's own metadata database and the UI login (http://localhost:8080)
AIRFLOW_DB_PW=change_me_locally_too
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PW=change_me_admin
AIRFLOW_SECRET_KEY=change_me_any_long_random_text

# Cleaned data handling in the `clean` task: auto (default) | reuse | force  (see README)
NX_CLEAN_MODE=auto
